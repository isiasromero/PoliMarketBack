{
  "name": "polimarket-cli",
  "version": "1.0.0",
  "description": "PoliMarket - Hexagonal Architecture CLI System for Commercial Business Management",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:hybrid": "nest start",
    "start:api": "MODE=api nest start",
    "start:api:dev": "MODE=api nest start --watch",
    "start:cli": "MODE=cli nest start",
    "start:debug": "nest start --debug --watch",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/shared/infrastructure/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/shared/infrastructure/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/shared/infrastructure/database/data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^10.0.0",
    "better-sqlite3": "^9.4.3",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cli-table3": "^0.6.3",
    "figlet": "^1.7.0",
    "inquirer": "^9.2.15",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
